# Adyapan HRMS Environment Variables
# Copy this file as .env and fill in actual values
# NEVER commit .env files with real credentials

# Backend
PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://user:password@localhost:5432/adyapan_hrms?schema=public"

# JWT Secrets — MUST be unique, random, 64+ character strings in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_ME_USE_RANDOM_64_CHAR_STRING"
JWT_REFRESH_SECRET="CHANGE_ME_USE_DIFFERENT_RANDOM_64_CHAR_STRING"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Cookie signing secret — MUST be random 64+ char string in production
COOKIE_SECRET="CHANGE_ME_USE_RANDOM_64_CHAR_STRING_FOR_COOKIES"

# Docker Compose
POSTGRES_USER=hrms_user
POSTGRES_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
POSTGRES_DB=adyapan_hrms
REDIS_PASSWORD="CHANGE_ME_REDIS_PASSWORD"

# AWS S3 Storage (optional)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="adyapan-hrms-storage"

# AI Copilot & ATS Resume Screening (optional)
GEMINI_API_KEY=""

# Frontend
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/api/v1"

# CRM Sync Configuration
# URL of the CRM backend that provides employee data
CRM_BACKEND_URL="https://your-crm-backend-domain.com"
# API key shared with CRM for pull-based sync (same as HRMS_SYNC_API_KEY on CRM side)
CRM_SYNC_API_KEY=""
# Webhook secret for verifying push notifications from CRM (same as HRMS_WEBHOOK_SECRET on CRM side)
CRM_WEBHOOK_SECRET=""
