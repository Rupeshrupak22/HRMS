{
  "name": "adyapan-hrms-root",
  "version": "1.0.0",
  "description": "Adyapan HRMS - Production-Ready Enterprise HR Management System",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "seed": "npm --prefix backend run seed",
    "prisma:push": "npm --prefix backend run prisma:push"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
